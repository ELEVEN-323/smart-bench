# 全局 Mock 开关（默认 true = 全用假数据，无需任何 API Key 即可演示）
# 改为 false 才切换为真实大模型（需同时配置 VITE_LLM_API_KEY）
VITE_USE_MOCK=true

# 大模型（DeepSeek）
VITE_LLM_PROVIDER=deepseek
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://api.deepseek.com
VITE_LLM_MODEL=deepseek-chat

# 高德地图（填 Key 后位置检索自动切真地图；SecurityCode 与 Key 成对使用）
VITE_AMAP_KEY=
VITE_AMAP_SECURITY=
VITE_AMAP_CENTER=116.397428,39.90923
# 地图样式（可选，默认 macaron；可选 normal/whitesmoke/macaron/fresh/grey/light/dark/blue/darkblue/graffiti）
VITE_AMAP_STYLE=

# Supabase 实时数据库（后续多杆联动使用）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
